# Digital Agency AI · Plesk production configuration (never commit real secrets)
APP_NAME="Digital Agency AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<target-domain>
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=digital_agency_ai
DB_USERNAME=digital_agency_ai_web
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=
ASSISTANT_REASONING_EFFORT=none
OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=
OPENROUTER_TTS_VOICE=
TRUSTED_PROXIES=
